# Copia este archivo como «.env» y cambia lo que necesites.
# Todo esto también se puede editar desde la pantalla Ajustes.

# --- Servidor local ---------------------------------------------------
KEVIL_HOST=127.0.0.1
KEVIL_PORT=8756
KEVIL_OPEN_BROWSER=true

# --- Almacenamiento ---------------------------------------------------
# Por defecto: la carpeta «data» junto al programa.
# KEVIL_DATA_DIR=/ruta/a/mis/datos

# --- ffmpeg -----------------------------------------------------------
# Sólo si no está en el PATH del sistema.
# KEVIL_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# KEVIL_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# --- Motor ------------------------------------------------------------
KEVIL_WORKERS=2
KEVIL_WATCH_INTERVAL_MINUTES=15
KEVIL_PUBLISHER_INTERVAL_SECONDS=60

# --- TikTok (https://developers.tiktok.com) ---------------------------
KEVIL_TIKTOK_CLIENT_KEY=
KEVIL_TIKTOK_CLIENT_SECRET=

# --- YouTube (opcional) -----------------------------------------------
# Leer tus vídeos no necesita nada: eso va por yt-dlp.
# Estas credenciales sólo hacen falta para PUBLICAR Shorts desde Kevil.
#   Google Cloud → API y servicios → YouTube Data API v3 + OAuth de escritorio
KEVIL_YOUTUBE_CLIENT_ID=
KEVIL_YOUTUBE_CLIENT_SECRET=
KEVIL_YOUTUBE_API_KEY=

# --- Inteligencia artificial (opcional) -------------------------------
# Puedes poner las DOS claves: si a una se le acaban los créditos o te
# limita por peticiones, Kevil pasa a la otra automáticamente.
# Sin ninguna clave, todo se genera en local (títulos, hashtags, ideas).
#   OpenRouter: https://openrouter.ai/keys
#   NVIDIA NIM: https://build.nvidia.com
KEVIL_AI_PRIMARY=openrouter          # cuál se intenta primero

KEVIL_OPENROUTER_API_KEY=
KEVIL_OPENROUTER_TEXT_MODEL=
KEVIL_OPENROUTER_IMAGE_MODEL=

KEVIL_NVIDIA_API_KEY=
KEVIL_NVIDIA_TEXT_MODEL=
KEVIL_NVIDIA_IMAGE_MODEL=

# --- Tu canal ---------------------------------------------------------
# Contexto para el asistente: cuanto más concreto, mejores las ideas.
KEVIL_CHANNEL_TOPIC=
KEVIL_CHANNEL_LANGUAGE=es
KEVIL_TARGET_UPLOADS_PER_WEEK=2
KEVIL_NOTIFICATIONS_DESKTOP=true

# --- Colores de tu marca (opcional) -----------------------------------
# Se pueden sacar solos del avatar de tu canal desde Ajustes → Colores.
# KEVIL_BRAND_ACCENT=#FF0033
# KEVIL_BRAND_ACCENT_2=#00C2FF

# --- Modo simulación --------------------------------------------------
# true = se procesa y se programa todo, pero no se publica nada de verdad.
KEVIL_DRY_RUN=false
